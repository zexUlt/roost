# ThreadSanitizer suppressions for the tsan preset.
#
# Only frames inside Qt go here, and only frames that never wrap roost code:
# TSan matches a pattern against every frame of both stacks of a report, so a
# roost function here would hide real races. See .claude/rules/threads.md.

# single_session_test, "data race on vptr": QFutureInterface<void>'s copy
# constructor (qfutureinterface.h) runs in QVariant::fromMetaType when a
# continuation is attached with .then() on the GUI thread; the destructor of
# that QVariant (QMetaTypeForType<QFutureInterface<void>>::getDtor) runs in
# QPromise::~QPromise on the IO thread. Qt orders the two with the mutex of
# the future's continuation, inside QtCore, which TSan does not see.
race:QFutureInterface<void>::QFutureInterface
race:QMetaTypeForType<QFutureInterface
