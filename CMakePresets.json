{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev — debug build with assertions",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GHOSTTY_ZIG_BUILD_FLAGS": "-Doptimize=ReleaseSafe"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "asan-ubsan — address and undefined behaviour sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GHOSTTY_ZIG_BUILD_FLAGS": "-Doptimize=ReleaseSafe",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release — what ships",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "asan-ubsan", "inherits": "base", "configurePreset": "asan-ubsan" },
    { "name": "release", "inherits": "base", "configurePreset": "release" }
  ]
}
