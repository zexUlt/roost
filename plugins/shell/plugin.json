{
  "id": "shell",
  "version": "0.1.0",
  "api": "0",
  "contributes": {
    "commands": [
      { "id": "shell.focusList", "title": "Focus the session list" },
      { "id": "shell.reportBug", "title": "Report a bug" },
      { "id": "terminal.copy", "title": "Copy the selection of the terminal" },
      { "id": "layout.splitRight", "title": "Split the panel to the right" },
      { "id": "layout.splitDown", "title": "Split the panel down" },
      { "id": "layout.intoTabs", "title": "Move the panel into tabs" },
      { "id": "layout.outOfTabs", "title": "Move the panel out of tabs" },
      { "id": "layout.close", "title": "Close the panel" },
      { "id": "layout.editLinks", "title": "Edit the links of the panel" }
    ],
    "keybindings": [
      { "command": "shell.focusList", "key": "Ctrl+\\" },
      { "command": "shell.reportBug", "mac": "Cmd+Shift+B" },
      { "command": "terminal.copy", "key": "Ctrl+Shift+C", "mac": "Cmd+C", "when": "terminal.view" }
    ]
  }
}
