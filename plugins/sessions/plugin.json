{
  "id": "sessions",
  "version": "0.1.0",
  "api": "0",
  "native": { "qt": "6.8", "qmlImportPath": "qml" },
  "contributes": {
    "commands": [
      { "id": "sessions.newSession", "title": "New session" }
    ],
    "keybindings": [
      { "command": "sessions.newSession", "key": "Ctrl+Shift+N", "mac": "Cmd+N" }
    ],
    "panels": [
      {
        "id": "list",
        "qml": "qml/SessionsPanel.qml",
        "inputs": {},
        "outputs": { "selected": "SessionRef" }
      }
    ]
  }
}
